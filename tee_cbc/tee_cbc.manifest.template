# Gramine direct/SGX manifest for the independent CBC plaintext TEE PoC.
# Paths are substituted by build_tee_cbc.sh.  The SGX variant deliberately
# uses an encrypted input mount; key provisioning is deployment-specific.
loader.log_level = "error"
loader.insecure__use_cmdline_argv = true
loader.env.SOCI_CBC_TMPDIR = "/opt/tee_cbc"
libos.entrypoint = "/opt/tee_cbc/soci_cbc_plaintext_benchmark"

fs.mounts = [
  { type = "chroot", path = "/opt/tee_cbc", uri = "file:@TEE_ROOT@" },
  { path = "/bin", uri = "file:/bin" },
  { path = "/usr/bin", uri = "file:/usr/bin" },
  { path = "/lib/x86_64-linux-gnu", uri = "file:/lib/x86_64-linux-gnu" },
  { path = "/lib64", uri = "file:/lib64" },
  { path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu" },
  @INPUT_MOUNT@
  { type = "tmpfs", path = "/tmp" }
]

sgx.file_check_policy = "allow_all_but_log"
sgx.trusted_files = [
  "file:@TEE_ROOT@/soci_cbc_plaintext_benchmark",
  "file:@TEE_ROOT@/",
  "file:/bin/",
  "file:/usr/bin/",
  "file:/lib/x86_64-linux-gnu/",
  "file:/lib64/",
  "file:/usr/lib/x86_64-linux-gnu/",
  "file:@DATA_DIR@/",
]
sgx.allowed_files = [
  "file:@TEE_ROOT@/",
]
sgx.max_threads = 16
sgx.edmm_enable = true
