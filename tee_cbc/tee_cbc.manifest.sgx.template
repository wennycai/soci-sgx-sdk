# Gramine SGX manifest for the independent CBC plaintext TEE PoC.
# This template is intentionally STRICT and fail-closed: every file the
# enclave may open must be listed individually in sgx.trusted_files (the
# concrete CBC/benchmark dependency set is enumerated by build_tee_cbc.sh
# via ldd).  There is no allow-all policy, no whole-directory trust and no
# allowed_files escape hatch; an undeclared dependency fails at
# gramine-sgx-sign or at enclave launch instead of being silently accepted.
#
# Encryption keys are deliberately distinct per mount:
#   /input -> "input_key": the cost data is prepared OUTSIDE the enclave by
#             the data owner with gramine-sgx-pf-crypt.  Production
#             provisioning of input_key (16-byte wrap key installed via
#             remote attestation + Gramine secret provisioning) is TODO;
#             until then the mount cannot be decrypted.
#   /work  -> "_sgx_mrenclave": Gramine's measurement-derived special key
#             (one of the SGX PAL special keys).  These files are
#             enclave-local CBC intermediates created and consumed inside
#             the enclave, so binding them to the enclave measurement is
#             exactly right.
#
# CBC's LP model, solution and solver log contain plaintext costs.  They
# live on the in-enclave encrypted mount at /work (SOCI_CBC_TMPDIR), keyed
# with the measurement-derived _sgx_mrenclave key: the host only ever sees
# ciphertext, and the benchmark removes the files on every exit path.  A
# plain tmpfs cannot be used here — Gramine tmpfs is per-process, so the
# CBC child process could not read the parent's LP.  /opt/tee_cbc holds
# only the static benchmark binary.  Input costs arrive via the encrypted
# Gramine filesystem at /input.
loader.log_level = "error"
loader.insecure__use_cmdline_argv = true
loader.env.SOCI_CBC_TMPDIR = "/work"
libos.entrypoint = "/opt/tee_cbc/soci_cbc_plaintext_benchmark"

fs.mounts = [
  { type = "chroot", path = "/opt/tee_cbc", uri = "file:@TEE_ROOT@" },
  { path = "/bin", uri = "file:/bin" },
  { path = "/usr/bin", uri = "file:/usr/bin" },
  { path = "/lib/x86_64-linux-gnu", uri = "file:/lib/x86_64-linux-gnu" },
  { path = "/lib64", uri = "file:/lib64" },
  { path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu" },
  @INPUT_MOUNT@
  { type = "encrypted", path = "/work", uri = "file:@WORK_DIR@", key_name = "_sgx_mrenclave" },
  { type = "tmpfs", path = "/tmp" }
]

sgx.file_check_policy = "strict"
sgx.trusted_files = [
  "file:@TEE_ROOT@/soci_cbc_plaintext_benchmark",
@SGX_TRUSTED_FILES@
]

sgx.max_threads = 16
sgx.edmm_enable = true
